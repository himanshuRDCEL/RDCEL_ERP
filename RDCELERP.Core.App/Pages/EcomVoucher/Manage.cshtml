                                <div class="col-md-12 mb-3">
                                  
                                </div>

                                <input type="hidden" asp-for="EcomVoucherViewModel.EcomVoucherId" id="hdnEcomVoucherId" />
                                <input type="hidden" asp-for="EcomVoucherViewModel.CreatedBy" />
                                <input type="hidden" asp-for="EcomVoucherViewModel.CreatedDate" />
                                <input type="hidden" asp-for="EcomVoucherViewModel.IsActive" />
                                <input type="hidden" asp-for="EcomVoucherViewModel.ModifiedBy" />
                                <input type="hidden" asp-for="EcomVoucherViewModel.ModifiedDate" />
                                
                                <input type="hidden" asp-for="EcomVoucherViewModel.CompanyId" id="CompanyIdHidden" />
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label>Voucher Type<span style="color:red;">*</span></label>
                                       <select id="voucherType" class="form-control" asp-for="EcomVoucherViewModel.EcomVoucherType">
                                            <option value="">Select Voucher Type</option>

    @foreach (var item in Model.EcomVoucherViewModel.EcomVoucherTypeList)
    {

                                                <option value="@item.Value" selected="@item.Selected">@item.Text</option>


    }
</select>
                                    </div>
                                    <div class="col-md-4 mb-3" id="code">
                                        <label for="">Code</label>
                                        <input asp-for="EcomVoucherViewModel.VoucherCode" class="form-control" placeholder="Code" readonly="readonly"/>
                                        <span asp-validation-for="EcomVoucherViewModel.VoucherCode" class="text-danger"></span>
                                    </div>
                                    <div id="countField"  class="col-md-4 mb-3">

                                        <div>
                                            <label for="">Count<span style="color:red;">*</span></label>
                                            <input asp-for="EcomVoucherViewModel.VoucherCount" class="form-control" placeholder="Count"/>
                                            <span id="countError" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div id="brandCategoryFields" class="row" style="display: none;">
                                        <div class="col-md-4 mb-3">
                                        <label>Brand<span style="color:red;">*</span></label>
                                        <select id="brandDropdown" class="form-control" asp-for="EcomVoucherViewModel.BrandId">
                                            <option value="">Select Brand</option>
                                            @if(Model.EcomVoucherViewModel.BrandList!=null){
                                            @foreach (var brand in Model.EcomVoucherViewModel.BrandList)
                                            {
                                                <option value="@brand.Value">@brand.Text</option>
                                            }
                                            }
                                        </select>
                                            <span id="brandError" class="text-danger"></span>

                                    </div>

                                  <div class="col-md-4 mb-3">
                                        <label>Category<span style="color:red;">*</span></label>
                                        <select id="categoryDropdown" class="form-control" asp-for="EcomVoucherViewModel.SelectedCategoryIds" multiple>
                                            <option value="">Select Category</option>
                                        </select>
                                            <span id="categoryError" class="text-danger"></span>

                                    </div> 
                                     
                                    </div>
                                            <div class="col-md-4 mb-3" id="import" style= "display:none;margin-top:29px;">
                                <button type = "button"id="importPhoneNoBtn" type="button"> Import Phone No.</button>

                                <input type="file" id="importFile" accept=".csv, .xlsx" style="display: none;" />

                                <div id="importedData"></div> <!-- Yaha Imported Data Show Hoga -->
                                </div>
                                 
                                  
                                </div>
                                <div id="phone" style="display:none;">
                                <div class="col-md-4 mb-3">
                                    <label for="">Phone</label>
                                    <input asp-for="EcomVoucherViewModel.Phoneno" class="form-control" placeholder="Phone No" />
                                    <span asp-validation-for="EcomVoucherViewModel.Phoneno" class="text-danger"></span>
                                </div>
                                </div>
                        
                                <div class="col-md-4 mb-3">
                                    <label for="">Start Date <span style="color:red;">*</span></label>
                                    <input asp-for="EcomVoucherViewModel.StartDate" class="form-control" placeholder="Last Name" />
                                    <span asp-validation-for="EcomVoucherViewModel.StartDate" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="">End Date <span style="color:red;">*</span></label>
                                    <input asp-for="EcomVoucherViewModel.EndDate" class="form-control" placeholder="End Date" />
                                    <span asp-validation-for="EcomVoucherViewModel.EndDate" class="text-danger"></span>
                                </div>
                               
                                <div class="col-md-4 mb-3" id="voucherstatus">
                                    <label for="">Voucher Status</label>
                                    <input asp-for="EcomVoucherViewModel.VoucherStatus"  class="form-control" placeholder="Voucher Status" readonly />
                                    <span asp-validation-for="EcomVoucherViewModel.VoucherStatus" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label>Value Type<span style="color:red;">*</span></label>
                                    <select id="valueType" class="form-control" asp-for="EcomVoucherViewModel.ValueType">
                                        <option value="">Select Value</option>
                                        @foreach (var item in Model.EcomVoucherViewModel.EcomVoucherValueTypeList)
                                        {
                                           
                                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>


                                        }
                                    </select>
                                </div>
                                <div id="fix">
                                <div class="col-md-4 mb-3">
                                        <label for="">Fixed Value</label>
                                        <input asp-for="EcomVoucherViewModel.FixedValue" class="form-control" placeholder="Fixed Value" />
                                        <span asp-validation-for="EcomVoucherViewModel.FixedValue" class="text-danger"></span>
                                </div>
                                </div>
                                <div id="perc" class="row" style="display:none;">
                                    <div class="col-md-4 mb-3">
                                        <label for="">Percentage</label>
                                        <input asp-for="EcomVoucherViewModel.Percentage" class="form-control" placeholder="Percentage" />
                                        <span asp-validation-for="EcomVoucherViewModel.Percentage" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="">Limit</label>
                                        <input asp-for="EcomVoucherViewModel.PercLimit" class="form-control" placeholder="Max Discount" />
                                        <span asp-validation-for="EcomVoucherViewModel.PercLimit" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4" style="sisplay:none margin-top:29px;" id="exportbuttonDiv">
                                    <button id="exportToExcel" type="button" class="exportbutton" type="button">Export</button>

                                </div>

                                <div class="col-md-12 mb-3">
                                    @if (Model.EcomVoucherViewModel.EcomPhoneSpecificsListVM != null && Model.EcomVoucherViewModel.EcomPhoneSpecificsListVM.Count > 0)
                                    {
                                        <table id="voucherTable" class="newtabledata  table align-items-center dataTable ">
