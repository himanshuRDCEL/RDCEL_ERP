                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script>
    $(document).ready(function () {


        $("#importPhoneNoBtn").click(function () {
            $("#importFile").click();
        });

        $("#importFile").change(function (event) {
            var file = event.target.files[0];
            if (!file) {
                alert("Please select a file.");
                return;
            }

            var reader = new FileReader();
            reader.onload = function (e) {
                var data = new Uint8Array(e.target.result);
                var workbook = XLSX.read(data, { type: "array" });

                var sheetName = workbook.SheetNames[0]; // First Sheet
                var sheetData = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName], { header: 1 });

                $("#importedData").empty(); // Purani Data Clear

                sheetData.forEach(function (row, index) {
                    if (index > 0) { // Skip Header Row
                        var phoneNumber = row[0] ? row[0].toString().trim() : ""; // 1st Column -> Phone Number
                        if (phoneNumber) {
                            $("#importedData").append(`
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control phone-number" value="${phoneNumber}" readonly />
                                                <input type="text" class="form-control voucher-code" name="EcomVoucherViewModel.EcomPhoneSpecificsListVM[${index - 1}].VoucherCode" placeholder="Enter Voucher Code" readonly />
                                                <input type="hidden" name="EcomVoucherViewModel.EcomPhoneSpecificsListVM[${index - 1}].Phoneno" value="${phoneNumber}" />
                                </div>
                            `);
                        }
                    }
                });
            };
            reader.readAsArrayBuffer(file);
        });
    });

</script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    function toggleFields() {
        var selectedValue = $("#voucherType").val();

        if (selectedValue === "1") { // Generic Voucher
            $("#countField").show();
            $("#voucherCount").attr("required", true);
            $("#brandCategoryFields").hide();
            $("#brandDropdown, #categoryDropdown").removeAttr("required");
            $("#brandError, #categoryError").text(""); // Clear errors
                $("#Phone").hide();

                $("#import").hide();
                $("#code").show();
                $("#voucherstatus").show();
                $("#exportbuttonDiv").hide();


        }
        else if (selectedValue === "2") { // Brand-Specific Voucher
            $("#countField").hide();
            $("#voucherCount").removeAttr("required");
            $("#brandCategoryFields").show();
            $("#brandDropdown, #categoryDropdown").attr("required", true);
                $("#Phone").hide();
                $("#import").hide();
                $("#code").show();
                $("#voucherstatus").show();
                $("#exportbuttonDiv").hide();



        }
        else if (selectedValue === "3") {
           
         $("#import").show();
                $("#exportbuttonDiv").show();
          $("#voucherstatus").hide();
                $("#countField").hide();
                $("#code").hide();

        }
        else { // Hide all fields if not Generic or Brand-Specific
            $("#countField, #brandCategoryFields").hide();
            $("#voucherCount, #brandDropdown, #categoryDropdown").removeAttr("required");
            $("#brandError, #categoryError").text("");
                $("#Phone").show();

                $("#exportbuttonDiv").hide();

                $("#code").hide();
               


        }
    }

        function toggleValueTypeFields() {
         
            var selectedValue = $("#valueType").val();
          
            if (selectedValue === "1") { // fix type
                $("#fix").show();
           
                $("#perc").hide();

            }
            else if (selectedValue === "2") { // prec type
                $("#perc").show();
                $("#fix").hide();
              
            }
            else { 
                $("#perc").hide();
                $("#fix").hide();


            }
        }

    // Run on page load
    toggleFields();
        toggleValueTypeFields();
        $("#voucherType").trigger("change");
        $("#valueType").trigger("change");
    // On dropdown change
    $("#voucherType").change(function () {
        toggleFields();
    }); 
    $("#valueType").change(function () {
            toggleValueTypeFields();
    });
   
    // Form submission validation
    $("form").submit(function (e) {
        alert("df");
       var selectedValue = $("#voucherType").val();
        var isValid = true;
        $("#brandError, #categoryError, #countError").text("");

       
        if (selectedValue === "1" && $("#voucherCount").val() === "") {
                
            $("#countError").text("Count is required for Generic Voucher.");
            isValid = false;
        }
        else if (selectedValue === "2") {
                      
            if (!$("#brandDropdown").val()) {
                $("#brandError").text("Brand is required.");
                isValid = false;
            }
            if (!$("#categoryDropdown").val()) {
                $("#categoryError").text("Category is required.");
                isValid = false;
            }
        }
           
        
       //  e.preventDefault();
        if (!isValid) {
            e.preventDefault(); // Stop form submission
        }
    });
});
   
    $(document).ready(function () {
        $(document).on('change', 'input[name="EcomVoucherViewModel.StartDate"]', function () {
            
            var startDateVal = new Date($(this).val());
            var voucherTypeId = $('#voucherType').val();
            let formattedStartDate = new Date(startDateVal).toISOString().slice(0, 16);

            if (startDateVal && voucherTypeId) {
                $.ajax({
                    url: './Manage?handler=VoucherDuration',
                     type: 'GET',
                    data: {
                        voucherTypeId: voucherTypeId,
                        startDate: formattedStartDate
                    },
                    success: function (endate) {
                      
                        $('input[name="EcomVoucherViewModel.EndDate"]').val(endate);
                        
                    }
                });
            }
        });


        $('#brandDropdown').change(function () {
            var brandId = $(this).val();

            if (brandId) {
                $.ajax({
                    url: './Manage?handler=GetCategoriesByBrand',
                    type: 'GET',
                    data: { brandId: brandId },
                    success: function (response) {
                        // Clear existing categories
                        $('#categoryDropdown').empty();
                        $('#categoryDropdown').append('<option value="">--Select Category--</option>');

                        // Populate new categories
                        $.each(response, function (index, category) {
                            console.log(category);
                            $('#categoryDropdown').append('<option value="' + category.value + '">' + category.text + '</option>');
                        });
                    },
                    error: function () {
                        alert('Failed to retrieve categories.');
                    }
                });
            } else {
                $('#categoryDropdown').empty();
                $('#categoryDropdown').append('<option value="">--Select Category--</option>');
            }
        });
    });

</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
    $(document).ready(function () {
        $('#exportToExcel').click(function () {
            var table = document.getElementById('voucherTable');
            var workbook = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });

            // Get today's date
            var today = new Date();
            var dateStr = today.toISOString().split('T')[0]; // yyyy-mm-dd

            // Generate filename
            var filename = 'VoucherData_' + dateStr + '.xlsx';

            XLSX.writeFile(workbook, filename);
        });
    });
</script>

<script>
    const selectBox = document.querySelector('.selectBox');
    const checkboxes = document.getElementById('checkboxList');
    const selectAll = document.getElementById('selectAll');

    function toggleCheckboxes() {
        checkboxes.style.display = checkboxes.style.display === 'block' ? 'none' : 'block';
    }

    function toggleSelectAll(source) {
        const inputs = checkboxes.querySelectorAll('input[type="checkbox"]:not(#selectAll)');
        inputs.forEach(input => input.checked = source.checked);
        updateDisplay();
    }

    function updateDisplay() {
        const selected = [];
        const inputs = checkboxes.querySelectorAll('input[type="checkbox"]:not(#selectAll)');
        let allChecked = true;

        inputs.forEach(input => {
            if (input.checked) selected.push(input.value);
            else allChecked = false;
        });

        selectBox.textContent = selected.length > 0 ? selected.join(', ') : 'Select Options';
        selectAll.checked = allChecked;
    }

    document.addEventListener('click', function (e) {
        if (!e.target.closest('.multiselect')) {
            checkboxes.style.display = 'none';
        }
    });
</script>



