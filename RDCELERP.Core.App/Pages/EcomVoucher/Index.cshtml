@page
@model RDCELERP.Core.App.Pages.EcomVoucher.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    RDCELERP.Model.Base.AccessRuleViewModel accessRule = (RDCELERP.Model.Base.AccessRuleViewModel)ViewBag.AccessRule;
    int i = 0;
    var URLPrefixforProd = ViewData["URLPrefixforProd"];
}

@if (ViewData["UserAuth"] != null)
{
    <script type="text/javascript">
           alert("@ViewData["UserAuth"]");
    </script>
}

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-12 mb-4">
                <div class="card border-0 shadow">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h2 class="fs-5 fw-bold mb-0">Ecom Voucher List</h2>
                            </div>
                            <div class="col text-end">
                                @if (accessRule != null && accessRule.CanAdd)
                                {
                                    <a asp-page="Manage"
                                       class="btn btn-primary">
                                        <i class="fa-solid fa-plus"></i>&nbsp; New Ecom Voucher
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row datefilter mt-2 mb-4">
                            <div class="col-md-4 mb-2">

                            </div>

                            <div class="col-md-8 text-right datefilter-right">
                                <input type="text" class="form-control d-inline mb-2" id="startdate" placeholder="Start Date">
                                <input type="text" class="form-control d-inline mb-2" id="enddate" placeholder="End Date">
                                
                                <button id="filter-dates" class="btn btn-primary">Filter</button>
                            </div>

                        </div>
                        <div class="table-responsive">
                            <table id="productCategoryDatatable" class="table align-items-center table-flush" border="1">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="all">Id</th>
                                        <th class="all">Actions</th>
                                        <th class="all">EcomVoucherName</th>
                                        <th class="all">Phone No</th>
                                        <th class="all">Voucher Code</th>
                                        <th class="all">Voucher Status</th>
                                        <th class="all">Active</th>
                                        <th class="all">EndDate</th>

                                        <th class="all">CreatedDate</th>
                                        
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="delete-conformation" tabindex="-1" role="dialog" aria-labelledby="deleteconformation">
    <div class="modal-dialog" style="width:501px !important;margin:0 auto;">
        <div class="modal-content">
            <div class="modal-header" style="background:#d9534f;color:white;">
                <h4 class="modal-title" id="delete-conformation">
                    Inactive Confirmation
                </h4>
            </div>
            <div class="modal-body">
                <form method="post">

                    <div class="row">
                        <div class="form-group">
                           @*  <input type="hidden" asp-for="tble.Id" id="hdnId" /> *@
                            <div class="col-sm-12">
                                <span>
                                    Are you sure you want to make this Product Category Inactive ?
                                </span>
                                @*<strong class="deletedValueName">
                                </strong>*@
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-bs-dismiss="modal">Cancel</button>
                        <input type="submit" asp-page-handler="Delete" class="btn btn-danger" value="Make Inactive" />
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
<script src="~/NewLayout/assets/js/jquery.dataTables.min.js"></script>
<script src="~/NewLayout/vendor/jquery-ui/jquery-ui.js"></script>
<script src="~/NewLayout/assets/js/exportTable.js"></script>
<script type="text/javascript">
    var table = null;
    $(document).ready(function () {

        var url = "@URLPrefixforProd/api/ListPage/GetEcomVoucherList";
        var startDate = $('#startdate').val();
        var endDate = $('#enddate').val();
        var companyId = @ViewBag.CompanyId;
        console.log(companyId);
        DataTable(url);

        var url = '@URLPrefixforProd/api/ListPage/GetEcomVoucherList?startDate=' + startDate + '&endDate=' + endDate + '&companyId=' + companyId;
        console.log(url);

        //date range Filter
        $('#filter-dates').click(function () {

            startDate = $('#startdate').val();
            endDate = $('#enddate').val();
            var url = '@URLPrefixforProd/api/ListPage/GetEcomVoucherList?startDate=' + startDate + '&endDate=' + endDate + 'companyId='+companyId;
            table = $('#productCategoryDatatable').DataTable();
            // Destroy the existing DataTable
            table.destroy();
            DataTable(url);
        });

    });

  

    function deleteConfirmProductCategory(_Id) {
       // alert(_dealId);
        $('#hdnId').val(_Id);
        $('#delete-conformation').modal('show');
    }

    $(document).ready(function () {
        $("#startdate").datepicker({
            defaultDate: null,
            onSelect: function (selectedDate) {
                $("#enddate").datepicker("option", "minDate", selectedDate);
            }
        });

        $("#enddate").datepicker({
            defaultDate: null,
            onSelect: function (selectedDate) {
                $("#startdate").datepicker("option", "maxDate", selectedDate);
            }
        });
    });
    //data table
    function DataTable(url) {
       
        table = $('#productCategoryDatatable').dataTable({
            "order": [[0, 'desc']],
            "processing": true,
            "serverSide": true,
            "scrollX": true,
            "paging": true,
            "filter": true,
            // "lengthMenu": [[10, 25, 50, 10000], [10, 25, 50, "All"]],
            
            "oLanguage": {
                "sEmptyTable": "No Voucher found"
            },
            "ajax": {
                "url": url,
                "type": "POST",
                "datatype": "json",
               
            },
            "columnDefs": [{
                "targets": [0],
                "visible": false,
                "searchable": false
            }],
            "responsive": true,
            "columns": [
                { "data": "ecomVoucherId", "name": "EcomVoucherId", "autoWidth": true, "orderable": false },
                { "data": "action", "name": "Actions", "autoWidth": true, "orderable": false },
                { "data": "ecomVoucherName", "name": "EcomVoucherName", "autoWidth": true, "orderable": true },
                { "data": "phoneno", "name": "Phoneno", "autoWidth": true, "orderable": true },
                { "data": "voucherCode", "name": "VoucherCode", "autoWidth": true, "orderable": true },
                { "data": "voucherStatus", "name": "Voucherstatus", "autoWidth": true, "orderable": true },
                { "data": "isActive", "name": "IsActive", "autoWidth": true, "orderable": true },
                { "data": "endDateString", "name": "EndDateString", "autoWidth": true, "orderable": true },
                { "data": "createdDateString", "name": "CreatedDateString", "autoWidth": true, "orderable": true },
            ]
        });
    }

</script>


