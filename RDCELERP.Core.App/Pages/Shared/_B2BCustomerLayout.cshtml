                    <div class="d-flex">
                        <img src="~/images/Rocking Deals Logo 2-01.png" style="max-width:223px; margin-left:50px;" />
                      
                    </div>

                </div>

                <!-- Navbar links -->
                <div style="text-align:center">
                    @Html.Partial("_MessagePartial")
                </div>
                <ul class="navbar-nav align-items-center profilewrapperbox">
