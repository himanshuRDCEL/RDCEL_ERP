@page
@model RDCELERP.Core.App.Pages.UTCDashboard
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<style>
    main.content .card.shadow {
        box-shadow: 0px 0px 0px 0px rgba(0, 0, 0, 0.1), 5px 4px 0px 0px rgb(237 10 21 / 67%) !important;
        /* border-top: red !important; */
        border-width: 39px;
        border-radius: 10px;
        padding: 20px 0px !important;
    }
    .icon-shape.icon-shape-primary{
        font-size:50px !important;
        opacity:0.2;
    }
    .card-body{
        padding-top:0px;
    }
    .card{
    padding:0px !important;
    }
    .table-container {
        margin: 40px auto;
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    thead th {
        background: #ec0a14 !important;
        color: white;
        font-size: 14px !important;
        font-weight: bold;
        padding: 12px;
          
        text-align: center;
    }

    tbody tr {
        background: white;
        border-radius: 8px;
        box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
        transition: 0.3s;
    }

        tbody tr:hover {
            transform: scale(1.02);
        }

    tbody td {
        padding: 18px !important;
       
        font-size: 16px;
        border-bottom: 1px solid #ddd;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    .filterpopup{
        position: absolute;
        top: 77px;
        right: 0;
        width: 220px;
        background: white;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        border-radius: 6px;
        padding: 15px;
        display: none;
        z-index: 1000;
    }

    .datefilter input.form-control {
        width: 100%;
    }

    .filterpopup input[type="submit"]{
        width:100%;
      
    }
    #filterIcon{
        max-width: 32px;
    }
</style>

@if (Model.tblBusinessUnit.IsBulkOrder == true)
{
    <div class="row">
        <div class="col-md-12">
            <div class="row">
                <div class="col-12 mb-4">
                    <div class="card border-0 shadow">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col">
                                </div>
                            </div>
                        </div>

                        <div class="card-body text-center d-flex justify-content-center align-items-center" style="height: 600px;">
                            <div>
                                <img class="w-50 d-block mx-auto mb-4" src="~/images/logo.svg" />
                                <h1 class="fw-bold"><strong>Welcome to Rocking Deals</strong></h1>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
