@page
@model RDCELERP.Core.App.Pages.BusinessCustomer.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
    Layout = "_B2BCustomerLayout";
    ViewBag.RazorPayOrderId = Model.RazorpayOrderId;

}




  <div class="container">
      <div class="py-5 text-center">
        <h1>Checkout Form</h1>
      </div>
    </div>
    
    <div class="container">
      <div class="row">
        <form method="post">
        <div class="col-md-4 order-2">
          <h4 class="d-flex justify-content-between align-items-center mb-3">
            <span class=text-muted>Your Cart</span>
             @if(Model.ItemCartViewModelList!=null && Model.ItemCartViewModelList.Count > 0)
            {
            <span class="badge rounded-pill bg-secondary">@Model.ItemCartViewModelList.Count</span>
            }
          </h4>
          
            @if(Model.ItemCartViewModelList!=null && Model.ItemCartViewModelList.Count > 0)
            {
                    @for (int i = 0; i < Model.ItemCartViewModelList.Count; i++)
                    {
                        <li class="list-group-item d-flex justify-content-between lh-condensed">
                            <div>
                                <input type="hidden" name="ItemCartViewModelList[@i].ItemId" value="@Model.ItemCartViewModelList[i].ItemId" />
                                <input type="hidden" name="ItemCartViewModelList[@i].ItemMasterId" value="@Model.ItemCartViewModelList[i].ItemMasterId" />
                                <input type="hidden" name="ItemCartViewModelList[@i].SubTotalPrice" value="@Model.ItemCartViewModelList[i].SubTotalPrice" />
                                <input type="hidden" name="ItemCartViewModelList[@i].TotalPrice" value="@Model.ItemCartViewModel.TotalPrice" />
                                <input type="hidden" name="ItemCartViewModelList[@i].B2BTotalPrice" value="@Model.ItemCartViewModel.B2BTotalPrice" />
                                <input type="hidden" name="ItemCartViewModelList[@i].Itemcode" value="@Model.ItemCartViewModelList[i].Itemcode" />
                                <input type="hidden" name="ItemCartViewModelList[@i].ItemDesc" value="@Model.ItemCartViewModelList[i].ItemDesc" />
                                <input type="hidden" name="ItemCartViewModelList[@i].PurchaseQty" value="@Model.ItemCartViewModelList[i].PurchaseQty" />
                                <input type="hidden" name="ItemCartViewModelList[@i].Brand" value="@Model.ItemCartViewModelList[i].Brand" />

                                <h6 class="my-0">@Model.ItemCartViewModelList[i].ItemDesc</h6>
                                <h5>@Model.ItemCartViewModelList[i].PurchaseQty</h5>
                                <small class="text-muted">@Model.ItemCartViewModelList[i].Brand</small>
                            </div>
                            <span class="text-muted">@Model.ItemCartViewModelList[i].SubTotalPrice</span>
                        </li>
                    }


            }
          
          <div class="card-footer d-flex justify-content-between">
            <span>Total</span>
                <strong>₹@Model.ItemCartViewModel.TotalPrice</strong>
          </div>
       
        </div>
         
        <div class="col-md-8 order-1">
          <h4 class="mb-3">Billing Address</h4>
          <div class="row">
            <div class="col mb-4">
              <label for="First name"> First Name </label>
              <input type="text" class="form-control"asp-for="@Model.BusinessCustomerViewModel.FirstName"  placeholder="First name" aria-label="First name">
            </div>
            <div class="col mb-4">
              <label for="La\st name"> Last Name </label>
                    <input type="text" class="form-control" asp-for="@Model.BusinessCustomerViewModel.LastName" placeholder="Last name" aria-label="Last name">
            </div>
          </div>
         
          
          <div class="mb-4">
            <label for="email">Email</label>
                <input type="text" class="form-control" asp-for="@Model.BusinessCustomerViewModel.Email" placeholder="you@example.com" aria-label="email" readonly="readonly">
        </div>

           <div class="mb-4">
            <label for="email">Phone No.</label>
                <input type="text" class="form-control" asp-for="@Model.BusinessCustomerViewModel.PhoneNo" placeholder="you@example.com" aria-label="email" readonly="readonly">
        </div>
          
          <div class="mb-4">
            <label for="Address">Address</label>
                <input type="text" class="form-control"  placeholder="1234 Main St" aria-label="Address">
          </div>
          
          <div class="mb-4">
            <label for="Address2">Address 2 (optional)</label>
            <input type="text" class="form-control" placeholder="Appartment or suite" aria-label="Address2">
          </div>
          
          <div class="row">
             <div class="col">
              <label for="country">Country</label>
              <select class="form-select">
      <option selected>Choose...</option>
      <option value="1">One</option>
      <option value="2">Two</option>
      <option value="3">Three</option>
    </select>
            </div>
             <div class="col">
              <label for="state">State</label>
              <select class="form-select">
      <option selected>Choose...</option>
      <option value="1">One</option>
      <option value="2">Two</option>
      <option value="3">Three</option>
    </select>
            </div>
             <div class="col mb-4">
              <label for="zip">Zip Code</label>
              <input type="text" class="form-control" aria-label="zip">
            </div>
            
            <hr class="mb-4">
            
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault">
              <label class="form-check-label" for="flexCheckDefault">
                Shipping address is the same as my billing address
              </label>
            </div>
            
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="flexCheckChecked">
              <label class="form-check-label" for="flexCheckChecked">
                Save this information for next time
              </label>
            </div>
            
            <hr class="mb-4">
            
            <div class="form-check">
              <input class="form-check-input" type="radio" name="flexRadioDefault" id="flexRadioDefault1" checked>
              <label class="form-check-label" for="flexRadioDefault1">
                Credit card (Default)
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="flexRadioDefault" id="flexRadioDefault2">
              <label class="form-check-label" for="flexRadioDefault2">
                Debit card
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="flexRadioDefault" id="flexRadioDefault3">
              <label class="form-check-label" for="flexRadioDefault3">
                Paypal
              </label>
            </div>
            
          
          </div>
        
        <hr class="mb-4">
        
        <div class="d-grid gap-2">
          <button class="btn btn-primary btn-lg" type="submit">
            Continue to Checkout
          </button>

              
        </div>
        
      </div>
      </form>
    </div>

