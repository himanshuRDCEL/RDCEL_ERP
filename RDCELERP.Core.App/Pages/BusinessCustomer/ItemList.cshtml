<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {
        var userId = '@loginVM.BusinessCustomerViewModel.BusinessCustomerId';
        var searchValue = '';
        var url = "@URLPrefixforProd/api/ListPage/GetItems?customerid=" + userId + "&searchValue=" + searchValue;


        console.log(url);
        // Load items via AJAX
        $.ajax({
            url: url, // Update with your actual controller route
            type: 'GET',
            success: function (data) {
                var container = $('#item-container');
                container.empty(); // Clear any existing data

                if (data && data.length > 0) {
                    $.each(data, function (index, item) {
                        var html = `
                                <div class="item">
                                    <h3>${item.name}</h3>
                                    <p>Price: ₹${item.price}</p>
                                    <input type="hidden" name="ListItemViewModels[${index}].Price" value="${item.price}" />
                                    <input type="hidden" name="ListItemViewModels[${index}].ItemId" value="${item.itemId}" />
                                     <input type="checkbox" name="ListItemViewModels[${index}].IsSelected" value="true" />

                                    <label for="select-${index}"><strong>Select</strong></label>
                                    <input type="number" name="ListItemViewModels[${index}].Quantity" min="1" value="1" class="quantity-box" />
                                </div>`;
                        container.append(html);
                    });
                } else {
                        container.append(`
      <p>No items found.</p>
      <div class="col-md-4 mb-4">
        <div class="product-card bg-white p-3 border rounded">
          <img src="https://limegreen-whale-280151.hostingersite.com/wp-content/uploads/2025/05/coffee-maker_6-300x300.jpg" alt="Static Product" class="product-img w-100 mb-3">
          <h5>Coffee Maker</h5>
          <p class="text-muted small ellipsis-multiline">Morphy Richard</p>
          <p class="fw-bold text-primary mb-2">₹5000</p>

          <input type="hidden" name="ListItemViewModels[0].Price" value="500">
          <input type="hidden" name="ListItemViewModels[0].ItemId" value="101">

          <div class="mb-2">
              <a href="#" class="btn addtocartbtn">ADD TO CART</a>

          </div>
        </div>
      </div>
    `);
    
                }
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
            }
        });
    });
</script>
