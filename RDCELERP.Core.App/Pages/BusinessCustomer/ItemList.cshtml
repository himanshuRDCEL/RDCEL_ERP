@page
@model RDCELERP.Core.App.Pages.BusinessCustomer.ItemListModel
@{
    ViewData["Title"] = "Item List";
    Layout = "_B2BCustomerLayout";
    var URLPrefixforProd = ViewData["URLPrefixforProd"];

    RDCELERP.Model.Users.LoginViewModel loginVM = (RDCELERP.Model.Users.LoginViewModel)ViewBag.LoginUser;
}
<style>
    .ecard-container {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    .ecard {
        border: 1px solid #ccc;
        padding: 12px;
        border-radius: 8px;
        width: 200px;
    }

    .quantity-box {
        width: 50px;
        margin-top: 8px;
    }

    .item {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        width: 320px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-family: sans-serif;
    }

    .product-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 16px;
        font-weight: bold;
    }

    .inner-card {
        border: 1px solid #ddd;
        padding: 15px;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .price {
        color: #ec020df7;
    }

    .select-container {
        display: flex;
        align-items: baseline;
        gap: 8px;
    }

        .select-container input[type="checkbox"] {
            transform: scale(1.2);
        }

    .quantity-box {
        width: 60px;
        padding: 5px;
        border: 1px solid #ddd;
        border-radius: 5px;
        text-align: center;
        font-size: 16px;
    }

        .quantity-box:focus {
            outline: 2px solid #007bff;
        }

    .ListItemViewModels-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        justify-content: center;
        padding: 20px;
    }

    /* Filters Section */
    .filters-container {
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: flex;
        align-items: end;
        gap: 10px;
        font-family: sans-serif;
    }

        /* Labels Styling */
        .filters-container .form-label {
            font-weight: bold;
            color: #333;
        }

        /* Input & Select Box */
        .filters-container .form-control,
        .filters-container .form-select {
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 8px;
            font-size: 14px;
            transition: 0.3s;
            width: 100%;
            margin-top: 8px;
        }

            .filters-container .form-control:focus,
            .filters-container .form-select:focus {
                border-color: #007bff;
                outline: none;
                box-shadow: 0px 0px 5px rgba(0, 123, 255, 0.3);
            }

        /* Button Styling */
        .filters-container .btn-primary {
            background-color: #28a745;
            border: none;
            color: #fff;
            font-weight: bold;
            padding: 10px 15px;
            border-radius: 6px;
            transition: 0.3s;
            width: 100%;
        }

    .allbtn {
        background-color: #28a745;
        border: none;
        color: #fff;
        font-weight: bold;
        padding: 10px 15px;
        border-radius: 6px;
        transition: 0.3s;
        font-family: sans-serif;
    }

    .quantity-box {
        width: 60px;
        padding: 5px;
        border: 1px solid #ddd;
        border-radius: 5px;
        text-align: center;
    }

    /* Product Card Container */
    .product-card {
        width: auto;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        padding: 15px;
        transition: 0.3s;
        font-family: sans-serif;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

    /* Product Image */
    .product-image {
        width: 100%;
        border-radius: 8px;
    }

    /* Product Details */
    .product-details {
        padding: 10px;
    }

    .product-name {
        font-size: 18px;
        font-weight: bold;
        margin: 10px 0;
    }

    .product-description {
        font-size: 14px;
        color: #666;
        margin-bottom: 8px;
    }

    /* Price */
    .product-price {
        font-size: 16px;
        font-weight: bold;
        color: #007bff;
        display: block;
        margin-bottom: 10px;
    }

    /* Quantity and Checkbox */
    .product-actions {
        display: flex;
        align-items: end;
        gap: 10px;
        justify-content: space-between;
    }

    /* Quantity Input */
    .quantity-box {
        width: 50px;
        padding: 5px;
        border: 1px solid #ddd;
        border-radius: 5px;
        text-align: center;
    }

    /* Select Checkbox */
    .select-container {
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .select-container input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .select-container label {
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
        }

    .maincard {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
    }

    .ellipsis-multiline{
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .addtocartbtn{
        border: 1px solid #000;
        width: 100%;
        font-weight: bold;
    }
    .addtocartbtn:hover{
        background:#000;
        color:#fff;
    }
     
   .h-search-form input{
     width: 47%;
    padding: 0 30px;
    border-radius: 12px;
    border: none;
    font-weight: 600;
    font-size: 16px;
    text-transform: capitalize;
    position: relative;
    color: #333;
    height: 54px;
   }
   .h-search-form button{
         position: relative;
    right: 110px;
    height: 36px;
    color: #fff;
    background: #000;
    top: 1px;
    border-radius: 50px;
    border: none;
    width: 100px;
    font-weight: 600;
    text-transform: capitalize;
   }
   .h-search-form button:hover{
      background: darkblue;
   }


</style>
<!-- Welcome Message -->
<div class="welcome" id="welcomeText"></div>
