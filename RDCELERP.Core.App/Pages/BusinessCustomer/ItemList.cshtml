<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {
        var userId = '@loginVM.BusinessCustomerViewModel.BusinessCustomerId';
        var searchValue = '';
        var url = "@URLPrefixforProd/api/ListPage/GetItems?customerid=" + userId + "&searchValue=" + searchValue;


        console.log(url);
        // Load items via AJAX
        $.ajax({
            url: url, // Update with your actual controller route
            type: 'GET',
            success: function (data) {
                var container = $('#item-container');
                container.empty(); // Clear any existing data

                if (data && data.length > 0) {
                    $.each(data, function (index, item) {
                        var html = `
                                <div class="item">
                                    <h3>${item.name}</h3>
                                    <p>Price: ₹${item.price}</p>
                                    <input type="hidden" name="ListItemViewModels[${index}].Price" value="${item.price}" />
                                    <input type="hidden" name="ListItemViewModels[${index}].ItemId" value="${item.itemId}" />
                                     <input type="checkbox" name="ListItemViewModels[${index}].IsSelected" value="true" />

                                    <label for="select-${index}"><strong>Select</strong></label>
                                    <input type="number" name="ListItemViewModels[${index}].Quantity" min="1" value="1" class="quantity-box" />
                                </div>`;
                        container.append(html);
                    });
                } else {
                    container.append('<p>No items found.</p>');
                }
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
            }
        });
    });
</script>

