<style>
    .ecard-container {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    .ecard {
        border: 1px solid #ccc;
        padding: 12px;
        border-radius: 8px;
        width: 200px;
    }

    .quantity-box {
        width: 50px;
        margin-top: 8px;
    }

</style>
<!-- Welcome Message -->
<div class="welcome" id="welcomeText"></div>
