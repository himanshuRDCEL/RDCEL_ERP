@page
@model RDCELERP.Core.App.Pages.BusinessCustomer.CartModel
@using RDCELERP.Model.BusinessCustomer
@{
    ViewData["Title"] = "Item List";
    Layout = "_B2BCustomerLayout";
    var URLPrefixforProd = ViewData["URLPrefixforProd"];

}
@Html.AntiForgeryToken()
<div class="container cart-container">
    <h3 class="mb-4 fw-bold">Shopping Cart</h3>

    <div class="row">
        <!-- Cart Items -->
        @if (Model.ItemCartViewModelList != null && Model.ItemCartViewModelList.Count>0)
        {
            <div class="col-lg-8">
                <!-- Item Start -->
                @foreach (var item in Model.ItemCartViewModelList)
                {
                    <div class="cart-item d-flex flex-column flex-md-row align-items-center"
                         data-itemid="@item.ItemId"
                         data-itemcartid="@item.ItemCartId" data-itemmasterid="@item.ItemMasterId">
                        <img src="@item.ImageUrl" class="cart-img me-md-4 mb-3 mb-md-0" alt="Product">

                        <div class="flex-grow-1">
                            <h5 class="mb-1">@item.ItemDesc</h5>
                            <p class="text-muted mb-2">Brand: @item.Brand</p>
                            <div class="d-flex align-items-center">
                                <label class="me-2 mb-0">Qty:</label>
                                <input type="number" value="@item.PurchaseQty" min="1" class="form-control quantity-input" data-oldqty="@item.PurchaseQty">
                            </div>
                            <p class="fw-bold mb-0 text-success">@item.B2bPrice</p>
                        </div>

                        <button class="btn btn-outline-danger ms-md-3 mt-3 mt-md-0 remove-item">Remove</button>
                    </div>
                }
                <!-- Item End -->
            </div>

            <!-- Cart Summary -->
            @if (@Model.ItemCartViewModel!= null)
            {
                <div class="col-lg-4 mt-4 mt-lg-0">
                    <div class="cart-summary">
                    <h5>Order Summary</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span id="summarySubtotal">@Model.ItemCartViewModel.SubTotalPrice</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping</span>
                        <span class="text-success">Free</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fs-5 fw-bold">
                        <span>Total</span>
                        <span id="summaryTotal">@Model.ItemCartViewModel.TotalPrice</span>
                    </div>
                    <form method="get" asp-page="/BusinessCustomer/Checkout">
                        <button type="submit" class="btn btn-checkout w-100 mt-4 py-2">Proceed to Checkout</button>
                    </form>
                </div>
            </div>
            }
        }
        else
        {
            <p>Your Cart is empty</p>
        }
    </div>
</div>
@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).on('change', '.quantity-input', function () {
            alert("Quantity update");

        const $input = $(this);
        const $cartItem = $input.closest('.cart-item');
        const itemId = $cartItem.data('itemid');
        const itemCartId = $cartItem.data('itemcartid');
            const itemMasterId = $cartItem.data('itemmasterid');
        const newQty = parseInt($input.val());
            const oldQty = parseInt($input.data('oldqty'));
       
        if (isNaN(newQty) || newQty < 1) {
            alert("Quantity must be at least 1");
            $input.val(1);
            return;
        }

        $.ajax({
            url: '/BusinessCustomer/Cart?handler=UpdateQuantity',
            method: 'POST',
            contentType: 'application/json',
            beforeSend: function (xhr) {
                xhr.setRequestHeader("XSRF-TOKEN",
                    $('input:hidden[name="__RequestVerificationToken"]').val());
            },
            data: JSON.stringify({
                ItemId: itemId,
                ItemCartId: itemCartId,
                ItemMasterId: itemMasterId,

                Quantity: newQty
            }),
            success: function (response) {
                if (response.success) {
                    alert(response.message);                       
                        // Update Order Summary totals
                        $('#summarySubtotal').text(`₹${response.data.subTotalPrice}`);
                        $('#summaryTotal').text(`₹${response.data.totalPrice}`);
                    } else {
                        alert("old");
                        $input.val(oldQty);
                    alert(response.message);
                }
            }
        });
    });

    $(document).on('click', '.remove-item', function () {
        const $btn = $(this);
        const $cartItem = $btn.closest('.cart-item');
        const itemId = $cartItem.data('itemid');

        if (!confirm("Are you sure you want to remove this item?")) return;

        $.ajax({
            url: '/BusinessCustomer/Cart?handler=RemoveItem',
            type: 'POST',
            contentType: 'application/json',
            beforeSend: function (xhr) {
                xhr.setRequestHeader("XSRF-TOKEN",
                    $('input:hidden[name="__RequestVerificationToken"]').val());
            },
            data: JSON.stringify({ ItemId: itemId }),
            success: function (response) {
                if (response.success) {
                    $cartItem.remove(); // Remove from UI
                    alert("Item removed successfully");
                        const total = response.data.totalPrice;
                        $('#summarySubtotal').text(`₹${total}`);
                        $('#summaryTotal').text(`₹${total}`);
                } else {
                    alert("Failed to remove item");
                }
            }
        });
    });
</script>

                    }