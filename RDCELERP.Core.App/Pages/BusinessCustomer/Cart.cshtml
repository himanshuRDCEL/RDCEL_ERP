@page
@model RDCELERP.Core.App.Pages.BusinessCustomer.CartModel
@{
    ViewData["Title"] = "Item List";
    Layout = "_B2BCustomerLayout";
    var URLPrefixforProd = ViewData["URLPrefixforProd"];

}


<!--cart page design-->
<div class="container cart-container">
    <h3 class="mb-4 fw-bold">Shopping Cart</h3>

    <div class="row">
        <!-- Cart Items -->
        <div class="col-lg-8">
            <!-- Item Start -->
            <div class="cart-item d-flex flex-column flex-md-row align-items-center">
                <img src="https://ecomall-be87.kxcdn.com/ecomall/wp-content/uploads/2023/03/82-400x400.jpg" class="cart-img me-md-4 mb-3 mb-md-0" alt="Product">
                <div class="flex-grow-1">
                    <h5 class="mb-1">Stylish Headphones</h5>
                    <p class="text-muted mb-2">Category: Electronics</p>
                    <div class="d-flex align-items-center">
                        <label class="me-2 mb-0">Qty:</label>
                        <input type="number" value="1" min="1" class="form-control quantity-input">
                    </div>

                    <p class="fw-bold mb-0 text-success">₹1,499</p>
                </div>
                <button class="btn btn-outline-danger ms-md-3 mt-3 mt-md-0">Remove</button>
            </div>
            <!-- Item End -->
            <!-- Add more .cart-item blocks as needed -->

        </div>

        <!-- Cart Summary -->
        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="cart-summary">
                <h5>Order Summary</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal</span>
                    <span>₹1,499</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Shipping</span>
                    <span class="text-success">Free</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between fs-5 fw-bold">
                    <span>Total</span>
                    <span>₹1,499</span>
                </div>
                <button class="btn btn-checkout w-100 mt-4 py-2">Proceed to Checkout</button>
            </div>
        </div>
    </div>
</div>

<!--cart page design end-->
