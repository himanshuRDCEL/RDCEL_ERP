@page
@model RDCELERP.Core.App.Pages.B2BItems.OrderDetailModel
@{
    ViewData["Title"] = "Order Detail";
    Layout = "_Layout";
}
@if (ViewData["UserAuth"] != null)
{
    <script type="text/javascript">
        alert("@ViewData["UserAuth"]");
    </script>
}
<h2>Order #@Model.OrderDetail.OrderNo</h2>
<p>Date: @Model.OrderDetail.OrderDate.ToString("dd-MMM-yyyy hh:mm tt")</p>
<p>Status: @Model.OrderDetail.OrderStatus</p>

<h3>Customer</h3>
<p>@Model.OrderDetail.CustomerVM.FullName (@Model.OrderDetail.CustomerVM.PhoneNo)</p>

<h3>Payment</h3>
<ul>
    <li>Amount: ₹@Model.OrderDetail.PaymentVM.Amount</li>
    <li>Status: @Model.OrderDetail.PaymentVM.PaymentStatus</li>
    <li>RazorPay Payment ID: @Model.OrderDetail.PaymentVM.RazorpayOrderId</li>
</ul>

<h3>Items</h3>
@foreach (var item in Model.OrderDetail.BookingItemsVm)
{
    <div>
        <b>@item.ItemDesc</b> - Qty: @item.Quantity,
      <b>Item Status</b>- @item.ItemStatusName
    </div>
}
