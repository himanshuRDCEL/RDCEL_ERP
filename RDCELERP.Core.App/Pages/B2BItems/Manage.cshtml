<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $('#imageUrlInput').on('input', function () {
        var url = $(this).val().trim();
        var img = $('#imagePreview');
        var error = $('#errorText');

        // Check for valid image URL format
        if (url.match(/\.(jpeg|jpg|gif|png|webp|bmp|svg)$/i)) {
            img.attr('src', url).show();
            error.text('');
        } else {
            img.hide().attr('src', '');
            error.text('Please enter a valid image URL (e.g., jpg, png).');
        }

        // Optional: Handle broken image link
        img.off('error').on('error', function () {
            $(this).hide().attr('src', '');
            error.text('Image could not be loaded. Please check the URL.');
        });
    });
</script>

